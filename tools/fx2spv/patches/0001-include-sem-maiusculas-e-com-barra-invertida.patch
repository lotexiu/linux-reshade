+// linux-reshade: os efeitos foram escritos no Windows, onde `\` separa pastas e maiúsculas não contam
+// (`#include ".\\Pasta\\Arquivo.fxh"`, `Reshade.fxh`). Aqui `\` vira `/` e o nome é procurado sem diferenciar
+// maiúsculas, componente por componente. Devolve vazio se não achar.
+static std::filesystem::path find_ignoring_case(const std::filesystem::path &base, const std::filesystem::path &relative)
+{
+	std::error_code ec;
+	std::filesystem::path current = base;
+	for (const std::filesystem::path &part : relative)
+	{
+		if (part == "." || part.empty())
+			continue;
+		if (part == "..")
+		{
+			current = current.parent_path();
+			continue;
+		}
+		if (std::filesystem::exists(current / part, ec))
+		{
+			current /= part;
+			continue;
+		}
+		const auto lower = [](std::string text) { for (char &c : text) c = (c >= 'A' && c <= 'Z') ? c + 32 : c; return text; };
+		const std::string wanted = lower(part.u8string());
+		bool found = false;
+		for (const auto &entry : std::filesystem::directory_iterator(current, ec))
+			if (lower(entry.path().filename().u8string()) == wanted) { current = entry.path(); found = true; break; }
+		if (!found)
+			return {};
+	}
+	return current;
+}
